# Copy to .env and adjust. All values have safe defaults; nothing here is required to run tests.
RECOVERY_OS_SEED=42
RECOVERY_OS_DB_PATH=recovery_os.db
RECOVERY_OS_KEY_PATH=ed25519_key.pem
# Money ceiling for auto-approval, in minor units (paise). 50000 = ₹500.00
RECOVERY_OS_MAX_AUTO_AMOUNT=50000
RECOVERY_OS_MAX_ATTEMPTS=3
# active provider: "simulated" | "razorpay_test"
RECOVERY_OS_PROVIDER=simulated

# --- LLM proposer (Phase 3); optional, cache-first, offline without a key ---
# Backend is picked from whichever key is set (Groq first, then Anthropic).
# ANTHROPIC_API_KEY=sk-ant-...        # -> claude-opus-5
# GROQ_API_KEY=gsk_...                # free tier -> openai/gpt-oss-120b, temp 0
# RECOVERY_OS_LLM_MODEL=<id>          # override the model for either backend
# RECOVERY_OS_LLM_CACHE_DIR=llm_cache # record-replay cache location

# --- Razorpay TEST MODE (live integration backend); optional ---
# Test keys only: the provider refuses anything that isn't rzp_test_...
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Optional: a captured test payment id, so the live refund test refunds for real.
# RAZORPAY_CAPTURED_PAYMENT_ID=pay_...
